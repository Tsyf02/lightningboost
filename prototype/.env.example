# ─── LightningBoost · .env.example (MERGED PERFECT) ─────────────────────────
# Copy to .env and fill in your values. NEVER commit .env to git.

# ── Cloud backend ─────────────────────────────────────────────────────────────
CLOUD_HOST=0.0.0.0
CLOUD_PORT=8000
CLOUD_BASE_URL=http://localhost:8000
# IMPORTANT: Set a strong secret — prevents others using your AMD GPU credits
CLOUD_API_KEY=change_me_to_a_strong_secret

# ── AMD vLLM endpoint (on your AMD Dev Cloud instance) ───────────────────────
# After deploying vLLM with ROCm: docker compose --profile gpu up vllm
VLLM_BASE_URL=http://YOUR_AMD_CLOUD_IP:8001
VLLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
VLLM_TIMEOUT=120

# ── HuggingFace ───────────────────────────────────────────────────────────────
# Required to download models. Get at: https://huggingface.co/settings/tokens
HF_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Resource thresholds (%) ──────────────────────────────────────────────────
RAM_THRESHOLD_HIGH=80       # above this → offload to AMD cloud
RAM_THRESHOLD_MEDIUM=60     # above this → show warning
CPU_THRESHOLD_HIGH=80       # above this → consider offloading
MIN_LOCAL_RAM_MB=500        # below this → must offload
MONITOR_INTERVAL=2          # psutil polling interval (seconds)

# ── Task timeouts (seconds) ───────────────────────────────────────────────────
LOCAL_TASK_TIMEOUT=30
CLOUD_TASK_TIMEOUT=120

# ── Frontend ──────────────────────────────────────────────────────────────────
DASHBOARD_REFRESH_SECONDS=3

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
