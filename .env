# ═══════════════════════════════════════════════════════════════════════════════
# LightningBoost — Environment Configuration
# ───────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env
#
# NEVER commit .env to git. Add it to .gitignore.
# For HuggingFace Spaces: paste each key into Settings → Secrets.
# For AMD Developer Cloud droplet: export vars or use a systemd EnvironmentFile.
# ═══════════════════════════════════════════════════════════════════════════════


# ─────────────────────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=LightningBoost
APP_ENV=development          # development | staging | production
DEBUG=true                   # Set false in production
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR


# ─────────────────────────────────────────────────────────────────────────────
# FASTAPI BACKEND  (runs on AMD MI300X droplet)
# ─────────────────────────────────────────────────────────────────────────────

# Public IP of your AMD Developer Cloud droplet
# Get it from: amd.digitalocean.com → your droplet → IP column
AMD_DROPLET_IP=YOUR_DROPLET_PUBLIC_IP

# Full backend base URL used by Streamlit frontend
AMD_BACKEND_URL=http://${AMD_DROPLET_IP}:8000

# FastAPI server bind settings (set on the droplet, not the frontend)
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=2            # Increase for multi-user load


# ─────────────────────────────────────────────────────────────────────────────
# MODEL SERVERS  (llama.cpp servers on the same AMD droplet)
# ─────────────────────────────────────────────────────────────────────────────

# Qwen3-VL-32B-Instruct — vision + text, ~19 GB VRAM (port 8080)
VL_MODEL_URL=http://${AMD_DROPLET_IP}:8080
VL_MODEL_NAME=Qwen3-VL-32B-Instruct-Q4_K_M
VL_MODEL_PATH=/models/qwen3vl/Qwen3-VL-32B-Instruct-Q4_K_M.gguf
VL_MMPROJ_PATH=/models/qwen3vl/qwen3vl_mmproj.gguf
VL_CONTEXT_LENGTH=8192
VL_GPU_LAYERS=99             # All layers on GPU

# Qwen3.5-35B-A3B — fast text-only MoE, ~20 GB VRAM (port 8081)
TEXT_MODEL_URL=http://${AMD_DROPLET_IP}:8081
TEXT_MODEL_NAME=Qwen3.5-35B-A3B-Q4_K_M
TEXT_MODEL_PATH=/models/qwen35/Qwen3.5-35B-A3B-Q4_K_M.gguf
TEXT_CONTEXT_LENGTH=4096
TEXT_GPU_LAYERS=99

# (Optional) Qwen3-235B-A22B-Instruct-2507 big-brain fallback (port 8082)
# Only enable if you need heavy reasoning tasks — uses 142 GB VRAM
BIG_MODEL_URL=http://${AMD_DROPLET_IP}:8082
BIG_MODEL_NAME=Qwen3-235B-A22B-Instruct-2507-Q4_K_M
BIG_MODEL_PATH=/models/qwen3_235b/Qwen3-235B-A22B-Instruct-2507-Q4_K_M.gguf
BIG_MODEL_ENABLED=false      # Set true only when needed


# ─────────────────────────────────────────────────────────────────────────────
# CLOUD CLIENT  (shared/client.py → CloudClient)
# ─────────────────────────────────────────────────────────────────────────────

CLOUD_BASE_URL=http://${AMD_DROPLET_IP}:8000
CLOUD_REQUEST_TIMEOUT=30     # seconds, for standard requests
CLOUD_STREAM_TIMEOUT=120     # seconds, for streaming / long inference
CLOUD_MAX_RETRIES=3
CLOUD_RETRY_BACKOFF=2.0      # exponential backoff base (seconds)


# ─────────────────────────────────────────────────────────────────────────────
# INFERENCE PARAMETERS  (used in shared/prompts.py defaults)
# ─────────────────────────────────────────────────────────────────────────────

# Qwen3 recommended sampling params (from official model card)
LLM_TEMPERATURE=0.6
LLM_TOP_P=0.95
LLM_TOP_K=20
LLM_MIN_P=0.0
LLM_PRESENCE_PENALTY=0.0     # 0–2; raise to reduce repetition, may cause lang-mixing

# Max output lengths
LLM_MAX_TOKENS_DEFAULT=1024
LLM_MAX_TOKENS_TIPS=512      # /analyze/stream — RAM/CPU tip responses
LLM_MAX_TOKENS_VISION=2048   # /analyze/vision — screenshot analysis
LLM_MAX_TOKENS_OFFLOAD=4096  # /offload — complex task reasoning

# Thinking token handling (Qwen3-Thinking variants)
LLM_STRIP_THINKING=true      # Strip </think> blocks before sending to frontend
LLM_THINKING_BUDGET=-1       # -1 = unlimited; set e.g. 2048 to cap reasoning length


# ─────────────────────────────────────────────────────────────────────────────
# LOCAL AGENT  (local_agent.py — runs on user's laptop, not the server)
# ─────────────────────────────────────────────────────────────────────────────

LOCAL_AGENT_PUSH_URL=http://${AMD_DROPLET_IP}:8000/stats
LOCAL_AGENT_INTERVAL=3       # seconds between stat pushes
LOCAL_AGENT_SECRET=CHANGE_ME # Shared secret to authenticate agent POSTs


# ─────────────────────────────────────────────────────────────────────────────
# TASK QUEUE  (backend job management)
# ─────────────────────────────────────────────────────────────────────────────

TASK_POLL_INTERVAL=2         # seconds between status polls (frontend)
TASK_TIMEOUT_DEFAULT=120     # seconds before a job is marked timed-out
TASK_TIMEOUT_VIDEO=600       # longer timeout for video render jobs
TASK_MAX_CONCURRENT=4        # max simultaneous GPU jobs


# ─────────────────────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────────────────────

# Random secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_generate_with_python_secrets_token_hex_32

# API key required on all backend requests (set same value on frontend + backend)
API_KEY=CHANGE_ME

# CORS — restrict to your HuggingFace Space URL in production
CORS_ORIGINS=*               # e.g. https://your-space.hf.space,http://localhost:8501


# ─────────────────────────────────────────────────────────────────────────────
# HUGGINGFACE  (model downloads + Space deployment)
# ─────────────────────────────────────────────────────────────────────────────

# Get token from: huggingface.co/settings/tokens (read scope is enough)
HF_TOKEN=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

HF_VL_MODEL_REPO=unsloth/Qwen3-VL-32B-Instruct-GGUF
HF_TEXT_MODEL_REPO=unsloth/Qwen3.5-35B-A3B-GGUF
HF_BIG_MODEL_REPO=unsloth/Qwen3-235B-A22B-Instruct-2507-GGUF

# Target quant to download (passed to huggingface-cli --include)
HF_VL_QUANT=*Q4_K_M*
HF_TEXT_QUANT=*Q4_K_M*
HF_BIG_QUANT=*Q4_K_M*


# ─────────────────────────────────────────────────────────────────────────────
# STREAMLIT FRONTEND
# ─────────────────────────────────────────────────────────────────────────────

STREAMLIT_PORT=8501
STREAMLIT_SERVER_HEADLESS=true       # Required for HuggingFace Spaces
STREAMLIT_SERVER_ENABLE_CORS=false
STREAMLIT_THEME_BASE=dark


# ─────────────────────────────────────────────────────────────────────────────
# MONITORING  (thresholds used in shared/models.py + frontend rules engine)
# ─────────────────────────────────────────────────────────────────────────────

RAM_WARN_PCT=70              # Yellow warning threshold
RAM_CRITICAL_PCT=85          # Red critical threshold — auto-suggest cloud offload
CPU_WARN_PCT=60
CPU_CRITICAL_PCT=80
DISK_WARN_PCT=80
DISK_CRITICAL_PCT=90
FREE_RAM_CRITICAL_MB=500     # Below this → immediate action recommended


# ─────────────────────────────────────────────────────────────────────────────
# AMD DEVELOPER CLOUD  (reference — droplet provisioned via DigitalOcean UI)
# ─────────────────────────────────────────────────────────────────────────────

# These are informational; not used by the app directly.
# Keep here so the team knows which droplet/plan is active.
AMD_CLOUD_REGION=nyc3             # DigitalOcean region
AMD_GPU_PLAN=mi300x               # GPU plan slug
AMD_DROPLET_IMAGE=rocm-quickstart # Pre-configured ROCm + vLLM image
# Cost ref: $1.99/hr · 192 GB HBM3 · ~50 hrs on $100 credit grant
